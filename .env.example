# ─── Application ──────────────────────────────────────────────────────────────
# Base URL where the app is served (no trailing slash)
APP_URL=https://your-domain.example.com/evaluacion-360

# Organization name used in emails and UI labels
ORG_NAME=Your Organization

# Salt used to generate report URL hashes — use a long random string
# Generate one with: php -r "echo bin2hex(random_bytes(24));"
APP_HASH_SALT=change-this-to-a-random-secret-string

# ─── Email (Google OAuth2) ─────────────────────────────────────────────────────
# Google account used to send notification emails
EMAIL_SENDER=your-google-account@gmail.com

# Display name shown in the From field of outgoing emails
EMAIL_SENDER_NAME=Your Organization

# Google OAuth2 credentials — create them in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Refresh token obtained by running admin/vendor/PHPMailer/get_oauth_token.php
GOOGLE_REFRESH_TOKEN=1//xxxx

# ─── Admin panel ──────────────────────────────────────────────────────────────
# Bcrypt hash of the admin panel password.
# Generate with: php -r "echo password_hash('yourpassword', PASSWORD_BCRYPT);"
ADMIN_PASSWORD_HASH=$2y$10$xxxx
